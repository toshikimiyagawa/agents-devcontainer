#!/usr/bin/env bash
# Runs once on container create (postCreateCommand).
# Materializes dotfiles into $HOME from /workspace/dotfiles/.
# Safe to re-run.
set -euo pipefail

PROJECT="${AGENTS_DOTFILES_PROJECT:-/workspace/dotfiles}"

log() { printf '[agents-post-create] %s\n' "$*"; }

# --- 0. Sync base dotfiles from upstream (non-fatal) --------------------------
if command -v agents-dotfiles-sync >/dev/null 2>&1; then
  agents-dotfiles-sync || log "warn: agents-dotfiles-sync failed (non-fatal)"
fi

# --- 1. Symlinked dotfiles ----------------------------------------------------
link_one() {
  local name="$1"
  if [[ ! -e "$PROJECT/$name" ]]; then
    log "skip $name (no source)"
    return 0
  fi
  rm -rf "$HOME/$name"
  ln -sfn "$PROJECT/$name" "$HOME/$name"
  log "linked $name -> $PROJECT/$name"
}

link_one ".zshrc"
link_one ".tmux.conf"
link_one ".config"

# --- 2. Project-only state dirs (.claude, .gemini, .codex) --------------------
# Runtime state: only in the project (gitignored), never baked into the image.
for name in .claude .gemini .codex; do
  mkdir -p "$PROJECT/$name"
  rm -rf "$HOME/$name"
  ln -s "$PROJECT/$name" "$HOME/$name"
  log "linked $name -> $PROJECT/$name"
done

# --- 2a. Hermes state ---------------------------------------------------------
# Hermes installs its executable payload under ~/.hermes/hermes-agent, and the
# ~/.local/bin/hermes wrapper points there directly. Keep ~/.hermes as a real
# directory; only persist user-managed state entries into project dotfiles.
persist_hermes_state() {
  mkdir -p "$PROJECT/.hermes"

  if [[ -L "$HOME/.hermes" ]]; then
    rm -f "$HOME/.hermes"
  fi
  mkdir -p "$HOME/.hermes"

  local name
  for name in memories; do
    if [[ -e "$HOME/.hermes/$name" && ! -L "$HOME/.hermes/$name" && ! -e "$PROJECT/.hermes/$name" ]]; then
      mv "$HOME/.hermes/$name" "$PROJECT/.hermes/$name"
    else
      rm -rf "$HOME/.hermes/$name"
    fi
    mkdir -p "$PROJECT/.hermes/$name"
    ln -s "$PROJECT/.hermes/$name" "$HOME/.hermes/$name"
    log "linked .hermes/$name -> $PROJECT/.hermes/$name"
  done

  # Hermes validates installed skill paths with realpath, so ~/.hermes/skills
  # must remain a real directory. Restore persisted skills into it instead of
  # symlinking the directory out of ~/.hermes.
  if [[ -L "$HOME/.hermes/skills" ]]; then
    rm -f "$HOME/.hermes/skills"
  fi
  mkdir -p "$PROJECT/.hermes/skills" "$HOME/.hermes/skills"
  if compgen -G "$PROJECT/.hermes/skills/*" >/dev/null 2>&1; then
    cp -a "$PROJECT/.hermes/skills/." "$HOME/.hermes/skills/"
  elif compgen -G "$HOME/.hermes/skills/*" >/dev/null 2>&1; then
    cp -a "$HOME/.hermes/skills/." "$PROJECT/.hermes/skills/"
  fi
  log "restored .hermes/skills from $PROJECT/.hermes/skills"

  for name in config.yaml .env; do
    if [[ -e "$HOME/.hermes/$name" && ! -L "$HOME/.hermes/$name" && ! -e "$PROJECT/.hermes/$name" ]]; then
      mv "$HOME/.hermes/$name" "$PROJECT/.hermes/$name"
    else
      rm -f "$HOME/.hermes/$name"
    fi
    touch "$PROJECT/.hermes/$name"
    ln -s "$PROJECT/.hermes/$name" "$HOME/.hermes/$name"
    log "linked .hermes/$name -> $PROJECT/.hermes/$name"
  done
}

persist_hermes_state

# --- 2b. Hermes Superpowers ---------------------------------------------------
bootstrap_hermes_superpowers() {
  local marker="$PROJECT/.hermes/.agents-superpowers-installed"
  local skill_dir="$HOME/.hermes/skills/superpowers"

  if [[ -f "$marker" && -f "$skill_dir/SKILL.md" ]]; then
    log "Hermes superpowers already bootstrapped"
    return 0
  fi

  if ! command -v hermes >/dev/null 2>&1; then
    log "skip Hermes superpowers bootstrap (hermes command not found)"
    return 0
  fi

  if hermes skills install --yes skills-sh/obra/superpowers; then
    if [[ -d "$skill_dir" ]]; then
      rm -rf "$PROJECT/.hermes/skills/superpowers"
      cp -a "$skill_dir" "$PROJECT/.hermes/skills/superpowers"
    fi
    touch "$marker"
    log "bootstrapped Hermes superpowers"
  else
    log "warn: Hermes superpowers bootstrap failed (non-fatal)"
  fi
}

bootstrap_hermes_superpowers

# --- 2c. .zsh_history ---------------------------------------------------------
# Persist shell history across rebuilds in the workspace (gitignored).
touch "$PROJECT/.zsh_history"
rm -f "$HOME/.zsh_history"
ln -sf "$PROJECT/.zsh_history" "$HOME/.zsh_history"
log "linked .zsh_history -> $PROJECT/.zsh_history"

# --- 3. SSH (copy from host bind-mount — OpenSSH requires strict permissions) -
# Source is the host ~/.ssh, bind-mounted read-only at /mnt/host-ssh (see the
# "mounts" entry in devcontainer.json). Copy (not symlink) so we can enforce
# 600/700, and copy only top-level regular files so non-regular entries like
# ~/.ssh/agent/ (a socket dir) don't abort the copy under `set -e`.
SSH_SRC="${AGENTS_SSH_SRC:-/mnt/host-ssh}"
if [[ -d "$SSH_SRC" ]] && compgen -G "$SSH_SRC/*" >/dev/null 2>&1; then
  rm -rf "$HOME/.ssh"
  mkdir -p "$HOME/.ssh"
  chmod 700 "$HOME/.ssh"
  find "$SSH_SRC" -maxdepth 1 -type f -exec cp -f {} "$HOME/.ssh/" \;
  find "$HOME/.ssh" -maxdepth 1 -type f -exec chmod 600 {} +
  log "copied .ssh from host ($SSH_SRC)"
else
  log "skip .ssh (no host keys mounted at $SSH_SRC)"
fi

# --- 4. tmux plugin manager + plugins -----------------------------------------
if [[ ! -d "$HOME/.tmux/plugins/tpm" ]]; then
  git clone --depth 1 https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
  log "cloned TPM"
fi
"$HOME/.tmux/plugins/tpm/bin/install_plugins" >/dev/null 2>&1 \
  || log "warn: tpm install_plugins failed (non-fatal)"

# --- 5. Project-specific tools ------------------------------------------------
if command -v agents-tools-install &>/dev/null; then
  agents-tools-install /workspace
fi

log "done"
