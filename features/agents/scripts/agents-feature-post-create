#!/usr/bin/env bash
set -euo pipefail

STATE_HOME="${AGENTS_STATE_HOME:-/usr/local/share/agents-devcontainer/state}"

log() { printf '[agents-feature-post-create] %s\n' "$*"; }

mkdir -p \
  "$STATE_HOME/gh" \
  "$STATE_HOME/claude" \
  "$STATE_HOME/gemini" \
  "$STATE_HOME/codex" \
  "$STATE_HOME/hermes" \
  "$STATE_HOME/cache"

link_state_dir() {
  local name="$1"
  local target="$2"
  mkdir -p "$target"
  rm -rf "$HOME/$name"
  ln -s "$target" "$HOME/$name"
  log "linked $name -> $target"
}

link_state_dir ".claude" "$STATE_HOME/claude"
link_state_dir ".gemini" "$STATE_HOME/gemini"
link_state_dir ".codex" "$STATE_HOME/codex"

if [ ! -e "$HOME/.hermes" ]; then
  ln -s "$STATE_HOME/hermes" "$HOME/.hermes"
  log "linked .hermes -> $STATE_HOME/hermes"
fi

log "done"

